{
  "name": "ai-security-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "services/api",
    "services/scanner",
    "packages/runtime",
    "packages/contracts",
    "packages/orchestration"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "lint": "eslint .",
    "test": "node --test tests/unit/*.test.mjs",
    "test:lab": "node --test tests/lab/*.test.mjs",
    "check:openapi": "redocly lint packages/contracts/openapi.json --config redocly.yaml",
    "lab": "node scripts/lab.mjs",
    "lab:generate": "node scripts/lab.mjs --generate-only",
    "build": "npm run build --workspace @ai-security/web",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "smoke:stack": "node --env-file-if-exists=.env scripts/smoke.mjs --stack",
    "test:web": "playwright test",
    "check:providers": "node scripts/check-providers.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "demo": "node --env-file-if-exists=.env scripts/demo-scan.mjs",
    "demo:lab": "node scripts/demo-collection.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.75.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0"
  }
}
