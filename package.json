{
  "name": "ai-security-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "services/api",
    "services/scanner",
    "packages/runtime"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "lint": "eslint .",
    "test": "node --test tests/unit/*.test.mjs",
    "build": "npm run build --workspace @ai-security/web",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "smoke:stack": "node --env-file-if-exists=.env scripts/smoke.mjs --stack",
    "test:web": "playwright test",
    "check:providers": "node scripts/check-providers.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0"
  }
}
