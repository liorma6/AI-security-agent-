# Local development and the allowed targets shared by API and worker.
# Use collection for TLS/HTTP evidence, orchestration_test for queue exercises, or bootstrap for UI development.
APP_MODE=collection
HOST=127.0.0.1
WEB_PORT=5173
API_PORT=3001
SCANNER_PORT=3002
ML_PORT=8000
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DATABASE=ai_security
REDIS_URL=redis://127.0.0.1:6379
QUEUE_NAME=scans
# Add a domain you are authorized to assess before submitting a collection request.
# List exact authorized hostnames, separated by commas. An empty list rejects every target.
ALLOWED_TARGETS=
# Future live SSL Labs adapter.
SSLLABS_EMAIL=
