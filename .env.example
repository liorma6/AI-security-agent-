# Local development and the allowed targets shared by API and worker.
# Use bootstrap for the UI-only mode, or orchestration_test with MongoDB and Redis.
APP_MODE=orchestration_test
HOST=127.0.0.1
WEB_PORT=5173
API_PORT=3001
SCANNER_PORT=3002
ML_PORT=8000
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DATABASE=ai_security
REDIS_URL=redis://127.0.0.1:6379
QUEUE_NAME=scans
# This reserved example name is used only by the orchestration demo.
# List exact authorized hostnames, separated by commas. An empty list rejects every target.
ALLOWED_TARGETS=demo.example.com
# Future live SSL Labs adapter.
SSLLABS_EMAIL=
